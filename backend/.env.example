NODE_ENV=development
PORT=4000
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Contact form email via Resend (https://resend.com/api-keys). Email is sent over HTTPS because
# free hosts such as Render block outbound SMTP. Without a verified domain, Resend only delivers
# to the email address you signed up with, so use that address for CONTACT_RECEIVER.
# Leave empty to disable sending — POST /api/contact then returns 503.
RESEND_API_KEY=
CONTACT_RECEIVER=
