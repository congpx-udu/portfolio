NODE_ENV=development
PORT=4000
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Contact form email (Gmail SMTP). SMTP_PASS is a Gmail App Password, not your login password:
# https://myaccount.google.com/apppasswords (requires 2-Step Verification).
# Leave empty to disable sending — POST /api/contact then returns 503.
SMTP_USER=
SMTP_PASS=
# Optional: inbox that receives messages (defaults to SMTP_USER)
CONTACT_RECEIVER=
